{
    "name": "triasfahrudin/ci4-grocery-crud-demo",
    "description": "Example module demonstrating Grocery CRUD library for CodeIgniter 4.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "triasfahrudin/grocery-crud": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../grocery-crud"
        }
    ]
}
