{
    "name": "triasfahrudin/ci4-grocery-crud-demo",
    "description": "Example CodeIgniter 4 project demonstrating Grocery CRUD library usage.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "codeigniter4/codeigniter4": "^4.5",
        "triasfahrudin/grocery-crud": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php spark serve"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../grocery-crud"
        }
    ]
}
